---
import { timeline } from "../config";
---

<ol class="timeline" role="list" data-timeline>
  {
    timeline.map((item) => (
      <li data-reveal>
        <span class="when mono">{item.when}</span>
        <span class="what">{item.what}</span>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --progress: 1;
    position: relative;
    display: grid;
    gap: 22px;
    padding-left: 26px;
  }

  :global(.js) .timeline {
    --progress: 0;
  }

  /* rail + scroll-linked progress */
  .timeline::before,
  .timeline::after {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 5px;
    width: 2px;
    border-radius: 2px;
    background: var(--surface-2);
  }

  .timeline::after {
    background: var(--accent);
    transform-origin: top;
    scale: 1 var(--progress);
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 88px 1fr;
    align-items: baseline;
    gap: 16px;
    font-size: 15px;
  }

  li::before {
    content: "";
    position: absolute;
    top: 6px;
    left: -26px;
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--surface-2);
    transition:
      box-shadow var(--dur-2) var(--ease-out),
      scale var(--dur-bounce) var(--ease-bounce);
  }

  li.is-past::before,
  :global(html:not(.js)) li::before {
    box-shadow: inset 0 0 0 6px var(--accent);
  }

  li.is-past::before {
    scale: 1.15;
  }

  .when {
    color: var(--ink-3);
    font-size: 13px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .what {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  @media (width <= 520px) {
    li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>

<script>
  import { clamp, watchVisibility } from "../scripts/motion";

  for (const list of document.querySelectorAll<HTMLElement>("[data-timeline]")) {
    const items = [...list.children] as HTMLElement[];
    let frame = 0;

    const update = () => {
      frame = 0;
      const anchor = window.innerHeight * 0.6;
      const rect = list.getBoundingClientRect();
      const progress = clamp((anchor - rect.top - 8) / (rect.height - 16), 0, 1);
      list.style.setProperty("--progress", progress.toFixed(4));
      for (const item of items) {
        item.classList.toggle("is-past", item.getBoundingClientRect().top + 12 <= anchor);
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    watchVisibility(list, (visible) => {
      if (visible) {
        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
      } else {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        update();
      }
    });
  }
</script>
