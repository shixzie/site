---
import { works } from "../config";
import Icon from "./Icon.astro";
---

<div class="works segmented">
  {
    works.map((work) => {
      const repoUrl = work.repo && `https://github.com/${work.repo}`;
      return (
        <article class="card work" data-spotlight data-reveal>
          <div class="top">
            <h3>
              <a class="main" href={work.href} target="_blank" rel="noreferrer">
                {work.title}
              </a>
            </h3>
            <span class="go" aria-hidden="true">
              <Icon name="arrow-up-right" size={16} />
            </span>
          </div>
          <p>{work.description}</p>
          <div class="foot">
            <span class="meta mono">{work.meta}</span>
            {repoUrl && repoUrl !== work.href && (
              <a class="repo mono" href={repoUrl} target="_blank" rel="noreferrer" title="Source on GitHub">
                <Icon name="github" size={14} />
                <span>{work.repo}</span>
              </a>
            )}
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .works {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Two columns: round the grid's outer corners, whatever the card count. */
  @media (width > 560px) {
    .works > * {
      border-radius: var(--radius-inner);
    }

    .works > :first-child {
      border-top-left-radius: var(--radius);
    }

    .works > :nth-child(2) {
      border-top-right-radius: var(--radius);
    }

    .works > :last-child {
      border-bottom-right-radius: var(--radius);
    }

    .works > :nth-last-child(2):nth-child(odd) {
      border-bottom-left-radius: var(--radius);
    }

    /* An odd last card spans the full row so the grid never leaves a hole. */
    .works > :last-child:nth-child(odd) {
      grid-column: 1 / -1;
      border-bottom-left-radius: var(--radius);
    }

    .works > :hover,
    .works > :focus-within {
      border-radius: var(--radius);
    }
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 22px 24px;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  h3 {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  p {
    color: var(--ink-2);
    font-size: 14px;
    text-wrap: pretty;
  }

  /* The title link stretches over the whole card; the repo link sits above it. */
  .main {
    outline: none;
  }

  .main::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .work:has(.main:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: auto;
    padding-top: 14px;
  }

  .meta {
    color: var(--ink-3);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .go {
    display: grid;
    flex: none;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--ink-3);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      translate var(--dur-spring) var(--ease-spring),
      rotate var(--dur-spring) var(--ease-spring);
  }

  .repo {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: -4px -8px;
    padding: 4px 8px;
    border-radius: 999px;
    color: var(--ink-3);
    font-size: 12px;
    letter-spacing: 0.02em;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .repo:hover,
  .repo:focus-visible {
    background: var(--bg);
    color: var(--ink);
  }

  .work:hover .go,
  .work:has(.main:focus-visible) .go {
    background: var(--ink);
    color: var(--bg);
    translate: 2px -2px;
    rotate: 45deg;
  }

  @media (width <= 560px) {
    .works {
      grid-template-columns: 1fr;
    }

    .works > * {
      border-radius: var(--radius-inner);
    }

    .works > :first-child {
      border-radius: var(--radius) var(--radius) var(--radius-inner) var(--radius-inner);
    }

    .works > :last-child {
      border-radius: var(--radius-inner) var(--radius-inner) var(--radius) var(--radius);
    }

    .works > :hover,
    .works > :focus-within {
      border-radius: var(--radius);
    }
  }
</style>
