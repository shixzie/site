---
// "Ask an AI about me": a floating button that opens a popover with deep links
// into ChatGPT, Claude, Gemini (Google AI Mode) and Perplexity, each prefilled
// with a question about you that points the assistant at /llms.txt first.
//
// Built on the native Popover API, so it opens without JavaScript and gets
// Esc / click-outside dismissal and focus return from the browser. JS only
// reveals the button after the first scroll, blinks the face, swaps the
// caption and powers "copy the prompt".
import { featured, profile, socials, works } from "../config";

// Brand marks from Remix Icon (Apache-2.0, https://remixicon.com), 24×24 grid.
const logos = {
  chatgpt:
    "M20.562 10.188c.25-.688.313-1.376.25-2.063c-.062-.687-.312-1.375-.625-2c-.562-.937-1.375-1.687-2.312-2.125c-1-.437-2.063-.562-3.125-.312c-.5-.5-1.063-.938-1.688-1.25S11.687 2 11 2a5.17 5.17 0 0 0-3 .938c-.875.624-1.5 1.5-1.813 2.5c-.75.187-1.375.5-2 .875c-.562.437-1 1-1.375 1.562c-.562.938-.75 2-.625 3.063a5.44 5.44 0 0 0 1.25 2.874a4.7 4.7 0 0 0-.25 2.063c.063.688.313 1.375.625 2c.563.938 1.375 1.688 2.313 2.125c1 .438 2.062.563 3.125.313c.5.5 1.062.937 1.687 1.25S12.312 22 13 22a5.17 5.17 0 0 0 3-.937c.875-.625 1.5-1.5 1.812-2.5a4.54 4.54 0 0 0 1.938-.875c.562-.438 1.062-.938 1.375-1.563c.562-.937.75-2 .625-3.062c-.125-1.063-.5-2.063-1.188-2.876m-7.5 10.5c-1 0-1.75-.313-2.437-.875c0 0 .062-.063.125-.063l4-2.312a.5.5 0 0 0 .25-.25a.57.57 0 0 0 .062-.313V11.25l1.688 1v4.625a3.685 3.685 0 0 1-3.688 3.813M5 17.25c-.438-.75-.625-1.625-.438-2.5c0 0 .063.063.125.063l4 2.312a.56.56 0 0 0 .313.063c.125 0 .25 0 .312-.063l4.875-2.812v1.937l-4.062 2.375A3.7 3.7 0 0 1 7.312 19c-1-.25-1.812-.875-2.312-1.75M3.937 8.563a3.8 3.8 0 0 1 1.938-1.626v4.751c0 .124 0 .25.062.312a.5.5 0 0 0 .25.25l4.875 2.813l-1.687 1l-4-2.313a3.7 3.7 0 0 1-1.75-2.25c-.25-.937-.188-2.062.312-2.937M17.75 11.75l-4.875-2.812l1.687-1l4 2.312c.625.375 1.125.875 1.438 1.5s.5 1.313.437 2.063a3.7 3.7 0 0 1-.75 1.937c-.437.563-1 1-1.687 1.25v-4.75c0-.125 0-.25-.063-.312c0 0-.062-.126-.187-.188m1.687-2.5s-.062-.062-.125-.062l-4-2.313c-.125-.062-.187-.062-.312-.062s-.25 0-.313.062L9.812 9.688V7.75l4.063-2.375c.625-.375 1.312-.5 2.062-.5c.688 0 1.375.25 2 .688c.563.437 1.063 1 1.313 1.625s.312 1.375.187 2.062m-10.5 3.5l-1.687-1V7.063c0-.688.187-1.438.562-2C8.187 4.438 8.75 4 9.375 3.688a3.37 3.37 0 0 1 2.062-.313c.688.063 1.375.375 1.938.813c0 0-.063.062-.125.062l-4 2.313a.5.5 0 0 0-.25.25c-.063.125-.063.187-.063.312zm.875-2L12 9.5l2.187 1.25v2.5L12 14.5l-2.188-1.25z",
  claude:
    "m5.92 15.3l3.94-2.2l.06-.2l-.06-.1h-.2L9 12.76l-2.24-.06l-1.96-.1l-1.9-.1l-.48-.1l-.42-.6l.04-.3l.4-.26l.58.04l1.26.1l1.9.12l1.38.08l2.04.24h.32l.04-.14l-.1-.08l-.08-.08L7.8 10.2L5.68 8.8l-1.12-.82l-.6-.4l-.3-.4l-.12-.84l.54-.6l.74.06l.18.04l.74.58l1.6 1.22L9.4 9.2l.3.24l.12-.08l.02-.06l-.14-.22L8.6 7L7.4 4.92l-.54-.86l-.14-.52c-.06-.2-.08-.4-.08-.6l.6-.84l.36-.1l.84.12l.32.28l.52 1.2l.82 1.86l1.3 2.52l.4.76l.2.68l.06.2h.14v-.1l.1-1.44l.2-1.74l.2-2.24l.06-.64l.32-.76l.6-.4l.52.22l.4.58l-.06.36L14.32 5l-.52 2.42l-.3 1.64h.18l.2-.22l.82-1.08l1.38-1.72l.6-.7l.72-.74l.46-.36h.86l.62.94l-.28.98l-.88 1.12l-.74.94l-1.06 1.42l-.64 1.14l.06.08h.14l2.4-.52l1.28-.22l1.52-.26l.7.32l.08.32l-.28.68l-1.64.4l-1.92.4l-2.86.66l-.04.02l.04.06l1.28.12l.56.04h1.36l2.52.2l.66.4l.38.54l-.06.4l-1.02.52l-1.36-.32l-3.2-.76l-1.08-.26h-.16v.08l.92.9l1.66 1.5l2.12 1.94l.1.48l-.26.4l-.28-.04l-1.84-1.4l-.72-.6l-1.6-1.36h-.1v.14l.36.54l1.96 2.94l.1.9l-.14.28l-.52.2l-.54-.12l-1.16-1.6l-1.2-1.8l-.94-1.64l-.1.08l-.58 6.04l-.26.3l-.6.24l-.5-.4l-.28-.6l.28-1.24l.32-1.6l.26-1.28l.24-1.58l.14-.52v-.04h-.14l-1.2 1.66l-1.8 2.46l-1.44 1.52l-.34.14l-.6-.3l.06-.56l.32-.46l2-2.56l1.2-1.58l.8-.92l-.02-.1h-.06l-5.28 3.44l-.94.12l-.4-.4l.04-.6l.2-.2l1.6-1.1z",
  gemini:
    "M24 12.024c-6.437.388-11.59 5.539-11.977 11.976h-.047C11.588 17.563 6.436 12.412 0 12.024v-.047C6.437 11.588 11.588 6.437 11.976 0h.047c.388 6.437 5.54 11.588 11.977 11.977z",
  perplexity:
    "m5.735 2l5.695 5.247V2.012h1.109v5.259L18.259 2v5.983h2.349v8.629h-2.342v5.327l-5.727-5.032v5.09h-1.11V16.99L5.742 22v-5.388H3.393v-8.63h2.342zm4.86 7.078H4.5v6.439h1.24v-2.031zM6.85 13.972v5.585l4.58-4.034V9.81zm5.72 1.497l4.588 4.03v-2.887h-.006v-2.646l-4.582-4.16zm5.696.048H19.5v-6.44h-6.047l4.814 4.363zm-1.115-7.534V4.519l-3.76 3.464zm-6.548 0l-3.76-3.464v3.464z",
} as const;

const siteUrl = Astro.site!.href.replace(/\/$/, "");
const firstName = profile.name.split(" ")[0];
const project = works[0] ? `${featured.title} (${featured.href}) and ${works[0].title}` : `${featured.title} (${featured.href})`;

const prompt = [
  `This is the public portfolio of ${profile.name} (@${profile.handle}), ${profile.role} based in ${profile.location}.`,
  `Start by reading ${siteUrl}/llms.txt, then tell me about ${firstName}.`,
  `Other sources: ${siteUrl}, ${socials.map((social) => social.href).join(", ")}. Projects include ${project}.`,
  `Summarize their background, what they build, and what they seem to care about.`,
].join(" ");
const q = encodeURIComponent(prompt);

const assistants = [
  { id: "chatgpt", label: "ChatGPT", href: `https://chatgpt.com/?q=${q}&hints=search` },
  { id: "claude", label: "Claude", href: `https://claude.ai/new?q=${q}` },
  { id: "gemini", label: "Gemini", via: "Google AI Mode", href: `https://www.google.com/search?udm=50&q=${q}` },
  { id: "perplexity", label: "Perplexity", href: `https://www.perplexity.ai/search?q=${q}` },
] as const;

const DEFAULT_CAPTION = "Pick your assistant";
---

<div class="askai" data-askai>
  <button class="trigger" type="button" popovertarget="askai-panel" aria-haspopup="dialog" aria-label="Ask an AI about me">
    <span class="hint">Ask an AI</span>
    <span class="face" aria-hidden="true">
      <svg viewBox="0 0 64 64" width="44" height="44">
        <clipPath id="askai-face"><circle cx="32" cy="32" r="32"></circle></clipPath>
        <g clip-path="url(#askai-face)">
          <rect width="64" height="64" fill="#303032"></rect>
          <circle cx="25" cy="50" r="33" fill="#fdefd7"></circle>
          <ellipse cx="7" cy="45" rx="6" ry="4" fill="#fbc9bb"></ellipse>
          <ellipse cx="43" cy="55" rx="6" ry="4" fill="#fbc9bb"></ellipse>
          {
            [
              [17, 37],
              [35, 42],
            ].map(([x, y]) => (
              <g transform={`translate(${x} ${y}) rotate(14)`}>
                <rect class="eye" data-askai-eye x="-3.2" y="-8.5" width="6.4" height="17" rx="3.2" fill="#1d1b1b" />
                <path class="smile" d="M-5.5 2.5Q0-5 5.5 2.5" fill="none" stroke="#1d1b1b" stroke-width="3.4" stroke-linecap="round" />
              </g>
            ))
          }
        </g>
      </svg>
      <span class="ping"></span>
    </span>
  </button>

  <div class="panel" id="askai-panel" popover role="dialog" aria-labelledby="askai-title" aria-describedby="askai-desc">
    <p class="title" id="askai-title">Ask an AI about me</p>
    <p class="desc" id="askai-desc">Opens your favourite assistant with a ready-made question.</p>
    <ul class="list" role="list">
      {
        assistants.map((assistant, index) => {
          const name = "via" in assistant ? `${assistant.label} (${assistant.via})` : assistant.label;
          return (
            <li style={`--i:${index}`}>
              <a
                href={assistant.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Ask ${name}`}
                title={`Ask ${name}`}
                data-caption={`Ask ${name}`}
              >
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                  <path d={logos[assistant.id]} />
                </svg>
              </a>
            </li>
          );
        })
      }
    </ul>
    <p class="caption" aria-hidden="true">
      <span data-askai-caption data-default={DEFAULT_CAPTION}>{DEFAULT_CAPTION}</span>
    </p>
    <button class="copy js-only" type="button" data-askai-copy data-prompt={prompt}>
      <span class="copy-label">
        <span class="idle">Copy the prompt instead</span>
        <span class="done">Copied, paste it anywhere</span>
      </span>
    </button>
    <span class="sr-only" aria-live="polite" data-askai-status></span>
  </div>
</div>

<style>
  .askai {
    position: fixed;
    right: 24px;
    bottom: 20px;
    z-index: 40;
  }

  /* ---------------------------------------------------------------- trigger */

  .trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 4px 4px 18px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--line),
      0 14px 34px -16px rgb(0 0 0 / 0.35);
    transition:
      opacity var(--dur-3) var(--ease-out),
      translate var(--dur-spring) var(--ease-spring),
      scale var(--dur-spring) var(--ease-spring),
      background-color var(--dur-2) var(--ease-out);
  }

  :global(.js) .askai:not(.is-visible) .trigger {
    opacity: 0;
    translate: 0 90px;
    pointer-events: none;
  }

  .trigger:hover {
    background: var(--surface-2);
    translate: 0 -2px;
  }

  .trigger:active {
    scale: 0.96;
  }

  .hint {
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .face {
    position: relative;
    display: block;
    width: 44px;
    height: 44px;
    transition: rotate var(--dur-bounce) var(--ease-bounce);
  }

  .trigger:hover .face {
    rotate: -8deg;
  }

  .eye,
  .smile {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      scale var(--dur-2) var(--ease-out),
      opacity var(--dur-1) var(--ease-out);
  }

  .smile {
    opacity: 0;
    scale: 0.5;
  }

  .askai.is-open .eye,
  .trigger:hover .eye {
    scale: 1 0.1;
    opacity: 0;
  }

  .askai.is-open .smile,
  .trigger:hover .smile {
    opacity: 1;
    scale: 1;
    transition:
      scale var(--dur-spring) var(--ease-bounce),
      opacity var(--dur-1) var(--ease-out);
  }

  /* "something new" dot: pings a couple of times, gone after the first open */
  .ping {
    position: absolute;
    top: -1px;
    right: -1px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 2.5px var(--surface);
    transition: scale var(--dur-spring) var(--ease-spring);
  }

  .ping::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    opacity: 0;
  }

  .askai.is-visible .ping::after {
    animation: ping calc(1.6s * var(--slowmo)) var(--ease-out) calc(0.5s * var(--slowmo)) 3;
  }

  .askai.was-opened .ping {
    scale: 0;
  }

  @keyframes ping {
    from {
      opacity: 0.7;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 3;
    }
  }

  /* ---------------------------------------------------------------- panel */

  .panel {
    position: fixed;
    inset: auto 24px 92px auto;
    width: 320px;
    max-width: calc(100vw - 32px);
    margin: 0;
    padding: 20px 18px 12px;
    overflow: visible;
    border: 0;
    border-radius: 26px 26px 10px 26px;
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--line),
      0 28px 60px -24px rgb(0 0 0 / 0.4);
    transform-origin: calc(100% - 36px) 100%;
    /* closed state (also the exit animation's destination) */
    opacity: 0;
    scale: 0.94;
    translate: 0 10px;
    transition:
      opacity var(--dur-2) var(--ease-out),
      scale var(--dur-2) var(--ease-in),
      translate var(--dur-2) var(--ease-in),
      display var(--dur-2) allow-discrete,
      overlay var(--dur-2) allow-discrete;
  }

  .panel:popover-open {
    opacity: 1;
    scale: 1;
    translate: none;
    transition:
      opacity var(--dur-2) var(--ease-out),
      scale var(--dur-spring) var(--ease-spring),
      translate var(--dur-spring) var(--ease-spring),
      display var(--dur-2) allow-discrete,
      overlay var(--dur-2) allow-discrete;
  }

  @starting-style {
    .panel:popover-open {
      opacity: 0;
      scale: 0.9;
      translate: 0 14px;
    }
  }

  .title {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .desc {
    margin: 2px 0 16px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.45;
  }

  /* segmented row of assistants, staggered in when the panel opens */
  .list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3px;
  }

  .list li {
    display: flex;
    transition:
      opacity var(--dur-2) var(--ease-out) calc(60ms * var(--slowmo) + var(--i) * 45ms * var(--slowmo)),
      translate var(--dur-spring) var(--ease-spring) calc(60ms * var(--slowmo) + var(--i) * 45ms * var(--slowmo));
  }

  @starting-style {
    .panel:popover-open .list li {
      opacity: 0;
      translate: 0 10px;
    }
  }

  .list a {
    display: grid;
    width: 100%;
    height: 54px;
    place-items: center;
    border-radius: var(--radius-inner);
    background: var(--bg);
    color: var(--ink);
    transition:
      border-radius var(--dur-3) var(--ease-out-expo),
      background-color var(--dur-2) var(--ease-out),
      scale var(--dur-spring) var(--ease-spring);
  }

  .list li:first-child a {
    border-radius: 27px var(--radius-inner) var(--radius-inner) 27px;
  }

  .list li:last-child a {
    border-radius: var(--radius-inner) 27px 27px var(--radius-inner);
  }

  .list a:hover,
  .list a:focus-visible {
    border-radius: 999px;
    background: var(--surface-2);
  }

  .list a:active {
    scale: 0.94;
  }

  .list svg {
    transition: scale var(--dur-spring) var(--ease-bounce);
  }

  .list a:hover svg {
    scale: 1.12;
  }

  .caption {
    height: 1lh;
    margin: 10px 0 4px;
    overflow: hidden;
    color: var(--ink-3);
    font-family: var(--font-mono-stack);
    font-size: 12px;
    text-align: center;
  }

  .caption > span {
    display: block;
  }

  .copy {
    width: 100%;
    min-height: 40px;
    border-radius: 12px;
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 500;
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      scale var(--dur-spring) var(--ease-spring);
  }

  .copy:hover {
    background: var(--bg);
    color: var(--ink);
  }

  .copy:active {
    scale: 0.97;
  }

  .copy-label {
    display: grid;
    height: 1lh;
    overflow: hidden;
  }

  .copy-label > span {
    grid-area: 1 / 1;
    transition:
      translate var(--dur-3) var(--ease-out-expo),
      opacity var(--dur-2) var(--ease-out);
  }

  .copy-label .done {
    translate: 0 100%;
    opacity: 0;
  }

  .copy.is-done {
    color: var(--green);
  }

  .copy.is-done .idle {
    translate: 0 -100%;
    opacity: 0;
  }

  .copy.is-done .done {
    translate: none;
    opacity: 1;
  }

  @media (width <= 600px) {
    .askai {
      right: 16px;
      bottom: 16px;
    }

    .panel {
      inset: auto 16px 84px auto;
    }
  }

  @media (width <= 360px) {
    .hint {
      display: none;
    }

    .trigger {
      padding-left: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .askai:not(.is-visible) .trigger,
    .trigger:hover {
      translate: none;
    }

    .panel,
    .panel:popover-open {
      scale: 1;
      translate: none;
    }

    .askai.is-visible .ping::after {
      animation: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion, timeScale, watchVisibility } from "../scripts/motion";

  for (const root of document.querySelectorAll<HTMLElement>("[data-askai]")) {
    const panel = root.querySelector<HTMLElement>("[popover]")!;
    const caption = root.querySelector<HTMLElement>("[data-askai-caption]")!;
    const copy = root.querySelector<HTMLButtonElement>("[data-askai-copy]")!;
    const status = root.querySelector<HTMLElement>("[data-askai-status]")!;
    const eyes = [...root.querySelectorAll<SVGElement>("[data-askai-eye]")];
    const reduced = prefersReducedMotion();

    /* Slide in once the visitor starts scrolling (like a chat bubble arriving). */
    const reveal = () => {
      if (window.scrollY < 40) return;
      root.classList.add("is-visible");
      window.removeEventListener("scroll", reveal);
    };
    window.addEventListener("scroll", reveal, { passive: true });
    reveal();

    panel.addEventListener("toggle", (event) => {
      const open = (event as ToggleEvent).newState === "open";
      root.classList.toggle("is-open", open);
      if (open) root.classList.add("was-opened");
      else setCaption(caption.dataset.default!);
    });

    // Close after picking an assistant; the new tab takes over.
    for (const link of panel.querySelectorAll<HTMLAnchorElement>("a")) {
      link.addEventListener("click", () => window.setTimeout(() => panel.hidePopover(), 150));
    }

    /* Caption rolls to the assistant under the cursor / focus. */
    let current = caption.textContent ?? "";
    const setCaption = (text: string) => {
      if (text === current) return;
      current = text;
      if (reduced) {
        caption.textContent = text;
        return;
      }
      const duration = 160 * timeScale();
      caption
        .animate({ translate: ["0 0", "0 -100%"], opacity: [1, 0] }, { duration, easing: "ease-in" })
        .finished.then(() => {
          caption.textContent = current;
          caption.animate(
            { translate: ["0 100%", "0 0"], opacity: [0, 1] },
            { duration: duration * 2, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
          );
        })
        .catch(() => {});
    };

    const list = panel.querySelector<HTMLElement>(".list")!;
    list.addEventListener("pointerover", (event) => {
      const link = (event.target as Element).closest<HTMLElement>("a");
      if (link) setCaption(link.dataset.caption!);
    });
    list.addEventListener("focusin", (event) => {
      const link = (event.target as Element).closest<HTMLElement>("a");
      if (link) setCaption(link.dataset.caption!);
    });
    list.addEventListener("pointerleave", () => setCaption(caption.dataset.default!));

    /* Copy the prompt for any other assistant. */
    let timer = 0;
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.prompt!);
      } catch {
        return;
      }
      copy.classList.add("is-done");
      status.textContent = "Prompt copied to clipboard";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        copy.classList.remove("is-done");
        status.textContent = "";
      }, 2200);
    });

    /* The little face blinks now and then while it's on screen. */
    if (!reduced) {
      let visible = false;
      watchVisibility(root, (isVisible) => (visible = isVisible));
      const blink = () => {
        if (visible && !document.hidden && root.classList.contains("is-visible") && !root.classList.contains("is-open")) {
          for (const eye of eyes) {
            eye.animate([{ scale: "1 1" }, { scale: "1 0.1", offset: 0.4 }, { scale: "1 1" }], {
              duration: 180 * timeScale(),
              easing: "ease-in-out",
            });
          }
        }
        window.setTimeout(blink, (2600 + Math.random() * 3400) * timeScale());
      };
      window.setTimeout(blink, 3000);
    }
  }
</script>
